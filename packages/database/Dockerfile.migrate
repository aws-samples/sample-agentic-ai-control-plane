# checkov:skip=CKV_DOCKER_2:Lambda base image; HEALTHCHECK is ignored by the
#   Lambda runtime and this is a one-shot migration job, not a long-running service.
# checkov:skip=CKV_DOCKER_3:Lambda manages its own unprivileged execution user;
#   setting USER here can break the Lambda runtime's bootstrap.
FROM public.ecr.aws/lambda/nodejs:22

WORKDIR ${LAMBDA_TASK_ROOT}

COPY package.json ./
RUN npm install --include=dev

COPY prisma/ ./prisma/
COPY prisma.config.ts ./
RUN npx prisma generate --schema=./prisma/schema.prisma

COPY migrate.ts seed.ts client.ts ./
RUN npx esbuild migrate.ts \
    --bundle \
    --platform=node \
    --target=node22 \
    --outfile=index.mjs \
    --format=esm \
    --banner:js="import { createRequire } from 'module'; const require = createRequire(import.meta.url);" \
    --external:@aws-sdk/*

CMD ["index.handler"]
