# Copy to `.env.local` for local development of the agent runtime.
# index.ts loads `.env` then `.env.local` (the latter overrides).
#
# Both gateway vars come from the AgentCoreGatewayStack CDK outputs after deploy:
#   AGENTCORE_GATEWAY_MCP_URL — full MCP endpoint URL (required at startup)
#   AGENTCORE_GATEWAY_ID      — gateway ID (the prefix before
#                               .gateway.bedrock-agentcore.<region>.amazonaws.com)
AGENTCORE_GATEWAY_MCP_URL=
AGENTCORE_GATEWAY_ID=

# Region used for Bedrock model inference (defaults to us-east-1 if unset).
BEDROCK_REGION=us-east-1

# AWS Solutions API-usage metrics token appended to outbound AWS calls. The CDK
# sets this in deployed environments; override locally only to test the value.
# Defaults to the AWSSOLUTION/<id>/v<version> constant in packages/aws-user-agent.
# USER_AGENT_STRING=AWSSOLUTION/SO0000/v0.1.0
