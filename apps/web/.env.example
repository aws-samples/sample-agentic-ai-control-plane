# Copy this file to `.env.local` and fill in the values.
#
# Local dev expects:
#   - Postgres running on localhost:5432 (`docker compose up -d` from repo root)
#   - AWS credentials available in your shell (e.g. `AWS_PROFILE=...`)
#   - The Cognito user pool's app client must list
#     `http://localhost:3000/api/auth/callback/cognito` as a callback URL.
#   - Deploy Cognito, AgentCore Gateway, Runtime stacks before development
#
# Production sets these via CDK; this file is only for `pnpm dev`.

# --- Better Auth (session signing + CSRF allowlist) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# --- Cognito (sign-in via OAuth) ---
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=

# --- Local Postgres (docker compose) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_ai_platform
DB_SCHEMA=agentic_ai_platform

# --- Bedrock AgentCore (gateway, registry, runtime) ---
AGENTCORE_REGION=us-east-1
AGENTCORE_REGISTRY_REGION=us-east-1
AGENTCORE_GATEWAY_ID=
AGENTCORE_ACCOUNT_ID=

# --- Persona simulation (playground bearer token mint) ---
PERSONA_USER_POOL_CLIENT_ID=
PERSONA_MASTER_PASSWORD_SECRET_ARN=
